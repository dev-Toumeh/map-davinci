	Tools = ordered() {
SAU_North_Counter3D_Ctrl = Background { NameSet = true, Inputs = { Width = Input { Value = 8, }, Height = Input { Value = 8, }, UseFrameFormatSettings = Input { Value = 0, }, TopLeftAlpha = Input { Value = 0, }, CValue = Input { Value = 2750, }, CDec = Input { Value = 0, }, CStart = Input { Value = 280, }, CEnd = Input { Value = 316, }, CSettle = Input { Value = 3, }, CIn = Input { Value = 274, }, CInLen = Input { Value = 6, }, COut = Input { Value = 380, }, COutLen = Input { Value = 6, }, CUnit = Input { Value = "كم", }, CUnitRight = Input { Value = 0, }, CSep = Input { Value = ",", }, CPoint = Input { Value = ".", }, CFont = Input { Value = "Open Sans", }, CStyle = Input { Value = "Bold", }, CUnitFont = Input { Value = "Damascus", }, CUnitStyle = Input { Value = "Bold", }, CSize = Input { Value = 0.2, }, CUnitSize = Input { Value = 0.17, }, CDigitW = Input { Value = 0.062, }, CSepW = Input { Value = 0.03, }, CUnitW = Input { Value = 0.13, }, CUnitGap = Input { Value = 0.04, }, CRoll = Input { Value = 0.22, }, CWindow = Input { Value = 0.28, }, CWindowSoft = Input { Value = 0.025, }, CFlash = Input { Value = 1, }, CFlashLen = Input { Value = 8, }, CShadow = Input { Value = 1, }, CShadowBlur = Input { Value = 26, }, CIconX = Input { Value = 0.12, }, CIconY = Input { Value = 0.5, }, CIconSize = Input { Value = 0.15, }, CIconIn = Input { Value = 274, }, CPosX = Input { Value = -0.321, }, CPosY = Input { Value = 0.147, }, CPosZ = Input { Value = 0.04, }, CLightX = Input { Value = 0.5, }, CLightY = Input { Value = -0.6, }, CScale = Input { Value = 0.25, }, CRot = Input { Value = 0, }, CFollow = Input { Value = 1, }, CFace = Input { Value = 0, }, CKeep = Input { Value = 0, }, CRef = Input { Value = 1.25, }, CPop = Input { Value = 0.15, }, CBaseR = Input { Value = 1, }, CBaseG = Input { Value = 1, }, CBaseB = Input { Value = 1, }, CAccR = Input { Value = 0.42, }, CAccG = Input { Value = 0.85, }, CAccB = Input { Value = 0.48, }, CNow = Input { Expression = ": local p = math.min(1, math.max(0, (time - SAU_North_Counter3D_Ctrl.CStart) / math.max(1, SAU_North_Counter3D_Ctrl.CEnd - SAU_North_Counter3D_Ctrl.CStart))); local t = math.floor(SAU_North_Counter3D_Ctrl.CValue * 10 ^ SAU_North_Counter3D_Ctrl.CDec + 0.5); return t * (1 - (1 - p) ^ SAU_North_Counter3D_Ctrl.CSettle)", }, CFade = Input { Expression = ": local a = math.min(1, math.max(0, (time - SAU_North_Counter3D_Ctrl.CIn) / SAU_North_Counter3D_Ctrl.CInLen)); local b = math.min(1, math.max(0, (time - SAU_North_Counter3D_Ctrl.COut) / SAU_North_Counter3D_Ctrl.COutLen)); return a * (1 - b)", }, CIconFade = Input { Expression = ": return math.min(1, math.max(0, (time - SAU_North_Counter3D_Ctrl.CIconIn) / SAU_North_Counter3D_Ctrl.CInLen))", }, CPopNow = Input { Expression = ": local a = math.min(1, math.max(0, (time - SAU_North_Counter3D_Ctrl.CIn) / SAU_North_Counter3D_Ctrl.CInLen)); return 1 - SAU_North_Counter3D_Ctrl.CPop * (1 - a * a * (3 - 2 * a))", }, CFl = Input { Expression = ": local d = time - SAU_North_Counter3D_Ctrl.CEnd; local L = SAU_North_Counter3D_Ctrl.CFlashLen; local f = 0; if d > -L and d <= 0 then f = 1 + d / L elseif d > 0 then f = math.max(0, 1 - d / (2 * L)) end; return SAU_North_Counter3D_Ctrl.CFlash * f * f * (3 - 2 * f)", }, CDist = Input { Expression = ": return math.sqrt((Camera3D1.Transform3DOp.Translate.X - SAU_North_Counter3D_Ctrl.CPosX) ^ 2 + (Camera3D1.Transform3DOp.Translate.Y - SAU_North_Counter3D_Ctrl.CPosY) ^ 2 + (Camera3D1.Transform3DOp.Translate.Z - SAU_North_Counter3D_Ctrl.CPosZ) ^ 2)", }, CHeading = Input { Expression = ": if Camera3D1.Transform3DOp.UseTarget == 1 then return -math.deg(math.atan2(Camera3D1.Transform3DOp.Target.X - Camera3D1.Transform3DOp.Translate.X, Camera3D1.Transform3DOp.Target.Y - Camera3D1.Transform3DOp.Translate.Y)) end; return Camera3D1.Transform3DOp.Rotate.Z", }, CTilt = Input { Expression = ": return math.deg(math.atan2(math.sqrt((Camera3D1.Transform3DOp.Translate.X - SAU_North_Counter3D_Ctrl.CPosX) ^ 2 + (Camera3D1.Transform3DOp.Translate.Y - SAU_North_Counter3D_Ctrl.CPosY) ^ 2), math.max(0.0001, Camera3D1.Transform3DOp.Translate.Z - SAU_North_Counter3D_Ctrl.CPosZ)))", }, CQ0 = Input { Expression = ": local k = (0 + SAU_North_Counter3D_Ctrl.CDec); if k < 0 then return 0 end; return math.floor(SAU_North_Counter3D_Ctrl.CNow / 10 ^ k)", }, CR0 = Input { Expression = ": local k = (0 + SAU_North_Counter3D_Ctrl.CDec); if k < 0 then return 0 end; local n = SAU_North_Counter3D_Ctrl.CNow; if k == 0 then return n - math.floor(n) end; local u = 10 ^ k; local lo = n - math.floor(n / u) * u; return math.min(1, math.max(0, lo - (u - 1)))", }, CV0 = Input { Expression = ": if (0 + SAU_North_Counter3D_Ctrl.CDec) < 0 then return 0 end; return 1", }, CQ1 = Input { Expression = ": local k = (1 + SAU_North_Counter3D_Ctrl.CDec); if k < 0 then return 0 end; return math.floor(SAU_North_Counter3D_Ctrl.CNow / 10 ^ k)", }, CR1 = Input { Expression = ": local k = (1 + SAU_North_Counter3D_Ctrl.CDec); if k < 0 then return 0 end; local n = SAU_North_Counter3D_Ctrl.CNow; if k == 0 then return n - math.floor(n) end; local u = 10 ^ k; local lo = n - math.floor(n / u) * u; return math.min(1, math.max(0, lo - (u - 1)))", }, CV1 = Input { Expression = ": if (1 + SAU_North_Counter3D_Ctrl.CDec) < 0 then return 0 end; return math.min(1, SAU_North_Counter3D_Ctrl.CQ1 + SAU_North_Counter3D_Ctrl.CR1)", }, CQ2 = Input { Expression = ": local k = (2 + SAU_North_Counter3D_Ctrl.CDec); if k < 0 then return 0 end; return math.floor(SAU_North_Counter3D_Ctrl.CNow / 10 ^ k)", }, CR2 = Input { Expression = ": local k = (2 + SAU_North_Counter3D_Ctrl.CDec); if k < 0 then return 0 end; local n = SAU_North_Counter3D_Ctrl.CNow; if k == 0 then return n - math.floor(n) end; local u = 10 ^ k; local lo = n - math.floor(n / u) * u; return math.min(1, math.max(0, lo - (u - 1)))", }, CV2 = Input { Expression = ": if (2 + SAU_North_Counter3D_Ctrl.CDec) < 0 then return 0 end; return math.min(1, SAU_North_Counter3D_Ctrl.CQ2 + SAU_North_Counter3D_Ctrl.CR2)", }, CQ3 = Input { Expression = ": local k = (3 + SAU_North_Counter3D_Ctrl.CDec); if k < 0 then return 0 end; return math.floor(SAU_North_Counter3D_Ctrl.CNow / 10 ^ k)", }, CR3 = Input { Expression = ": local k = (3 + SAU_North_Counter3D_Ctrl.CDec); if k < 0 then return 0 end; local n = SAU_North_Counter3D_Ctrl.CNow; if k == 0 then return n - math.floor(n) end; local u = 10 ^ k; local lo = n - math.floor(n / u) * u; return math.min(1, math.max(0, lo - (u - 1)))", }, CV3 = Input { Expression = ": if (3 + SAU_North_Counter3D_Ctrl.CDec) < 0 then return 0 end; return math.min(1, SAU_North_Counter3D_Ctrl.CQ3 + SAU_North_Counter3D_Ctrl.CR3)", }, CW = Input { Expression = ": return SAU_North_Counter3D_Ctrl.CV0 * SAU_North_Counter3D_Ctrl.CDigitW + SAU_North_Counter3D_Ctrl.CV1 * SAU_North_Counter3D_Ctrl.CDigitW + SAU_North_Counter3D_Ctrl.CV2 * SAU_North_Counter3D_Ctrl.CDigitW + SAU_North_Counter3D_Ctrl.CV3 * SAU_North_Counter3D_Ctrl.CSepW + SAU_North_Counter3D_Ctrl.CV3 * SAU_North_Counter3D_Ctrl.CDigitW", }, CRight = Input { Expression = ": local tw = SAU_North_Counter3D_Ctrl.CW + SAU_North_Counter3D_Ctrl.CUnitGap + SAU_North_Counter3D_Ctrl.CUnitW; local left = 0.5 - tw / 2; if SAU_North_Counter3D_Ctrl.CUnitRight > 0.5 then return left + SAU_North_Counter3D_Ctrl.CW end; return left + SAU_North_Counter3D_Ctrl.CUnitW + SAU_North_Counter3D_Ctrl.CUnitGap + SAU_North_Counter3D_Ctrl.CW", }, CUnitX = Input { Expression = ": if SAU_North_Counter3D_Ctrl.CUnitRight > 0.5 then return SAU_North_Counter3D_Ctrl.CRight + SAU_North_Counter3D_Ctrl.CUnitGap + SAU_North_Counter3D_Ctrl.CUnitW / 2 end; return SAU_North_Counter3D_Ctrl.CRight - SAU_North_Counter3D_Ctrl.CW - SAU_North_Counter3D_Ctrl.CUnitGap - SAU_North_Counter3D_Ctrl.CUnitW / 2", }, }, UserControls = ordered() { CValue = { LINKS_Name = "Value", LINKID_DataType = "Number", INPID_InputControl = "ScrewControl", INP_Default = 2750, INP_MinScale = 0, INP_MaxScale = 10000, ICS_ControlPage = "Counter", }, CDec = { LINKS_Name = "D