fault = 0,  ICS_ControlPage = "Counter", }, CSep = { LINKS_Name = "Thousands Separator", LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", TEC_Lines = 1,  ICS_ControlPage = "Counter", }, CPoint = { LINKS_Name = "Decimal Point", LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", TEC_Lines = 1,  ICS_ControlPage = "Counter", }, CFont = { LINKS_Name = "Digits Font", LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", TEC_Lines = 1,  ICS_ControlPage = "Look", }, CStyle = { LINKS_Name = "Digits Style", LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", TEC_Lines = 1,  ICS_ControlPage = "Look", }, CUnitFont = { LINKS_Name = "Unit Font", LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", TEC_Lines = 1,  ICS_ControlPage = "Look", }, CUnitStyle = { LINKS_Name = "Unit Style", LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", TEC_Lines = 1,  ICS_ControlPage = "Look", }, CSize = { LINKS_Name = "Text Size", LINKID_DataType = "Number", INPID_InputControl = "ScrewControl", INP_Default = 0.2, INP_MinScale = 0.05, INP_MaxScale = 0.5, ICS_ControlPage = "Look", }, CUnitSize = { LINKS_Name = "Unit Size", LINKID_DataType = "Number", INPID_InputControl = "ScrewControl", INP_Default = 0.17, INP_MinScale = 0.05, INP_MaxScale = 0.5, ICS_ControlPage = "Look", }, CDigitW = { LINKS_Name = "Digit Spacing", LINKID_DataType = "Number", INPID_InputControl = "ScrewControl", INP_Default = 0.062, INP_MinScale = 0.02, INP_MaxScale = 0.15, ICS_ControlPage = "Look", }, CSepW = { LINKS_Name = "Separator Spacing", LINKID_DataType = "Number", INPID_InputControl = "ScrewControl", INP_Default = 0.03, INP_MinScale = 0, INP_MaxScale = 0.1, ICS_ControlPage = "Look", }, CUnitW = { LINKS_Name = "Unit Width", LINKID_DataType = "Number", INPID_InputControl = "ScrewControl", INP_Default = 0.13, INP_MinScale = 0, INP_MaxScale = 0.5, ICS_ControlPage = "Look", }, CUnitGap = { LINKS_Name = "Unit Gap", LINKID_DataType = "Number", IN